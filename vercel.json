{
 "cleanUrls": true,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=63072000"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/_src/:path*",
   "destination": "/",
   "permanent": false
  },
  {
   "source": "/:path*",
   "has": [
    {
     "type": "host",
     "value": "aiengineered-hone9.vercel.app"
    }
   ],
   "destination": "https://aiengineered.co.uk/:path*",
   "permanent": true
  },
  {
   "source": "/:path*",
   "has": [
    {
     "type": "host",
     "value": "aiengineered-git-website-hone9.vercel.app"
    }
   ],
   "destination": "https://aiengineered.co.uk/:path*",
   "permanent": true
  }
 ]
}